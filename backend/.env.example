# BizSage3 Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///bizsage.db
CHECKPOINT_DB_URL=sqlite+aiosqlite:///checkpoints.db

# LLM
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Use "mock" for testing without API calls, "openai" for production
LLM_MODE=openai

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Diagnosis threshold (per design doc: >= 80 triggers diagnosis)
COMPLETE_THRESHOLD=80
