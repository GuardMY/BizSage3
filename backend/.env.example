# BizSage3 Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://bizsage_app:replace-this-postgres-password@localhost:5432/bizsage
CHECKPOINT_DB_URL=postgresql://bizsage_app:replace-this-postgres-password@localhost:5432/bizsage_checkpoint
CHECKPOINT_SETUP_ON_START=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_APPLICATION_NAME=bizsage-api
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
CHECKPOINT_POOL_SIZE=5

# Redis coordination and workers
REDIS_URL=redis://localhost:6379/0
SESSION_LOCK_TTL_SECONDS=120
REPORT_QUEUE_NAME=arq:report
KNOWLEDGE_QUEUE_NAME=arq:knowledge
REPORT_WORKER_CONCURRENCY=4
KNOWLEDGE_WORKER_CONCURRENCY=2
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_STALE_SECONDS=900

# LLM
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
# Enable full LLM request/response and tool trace logging when debugging.
LLM_TRACE_ENABLED=false

# AgentTrace user-conversation monitoring. Local runs are opt-in; Compose
# overrides this to true and uses its persistent agenttrace-data volume.
AGENTTRACE_ENABLED=false
AGENTTRACE_PROJECT=bizsage3-conversations
AGENTTRACE_STORAGE_URL=
AGENTTRACE_CAPTURE_INPUT=true
AGENTTRACE_CAPTURE_OUTPUT=true
AGENTTRACE_FLUSH_TIMEOUT_SECONDS=5
AGENTTRACE_RETENTION_DAYS=30
AGENTTRACE_MAX_STORAGE=2GB

# Industry knowledge base. Embeddings reuse OPENAI_* unless explicitly overridden.
# DashScope example (use a separate API key):
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024
# Existing collections must be rebuilt when the dimension changes.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-minio-secret-key
MINIO_SECURE=false
MINIO_BUCKET=bizsage-knowledge
KNOWLEDGE_UPLOAD_MAX_BYTES=20971520
# Used until an administrator selects a global retrieval strategy in the UI.
# Supported values: strict, progressive, industry_only, unfiltered, scene_boost
KNOWLEDGE_RETRIEVAL_DEFAULT_STRATEGY=strict

# Public web search. It remains disabled until a provider key is configured.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_STRATEGY=fallback
WEB_SEARCH_PROVIDERS=tavily,bing
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Access control (required). Use a long random value and keep it server-side.
ADMIN_TOKEN=replace-with-a-random-admin-token
AUTH_SESSION_HOURS=12
# Set true when the frontend is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Diagnosis threshold (per design doc: >= 80 triggers diagnosis)
COMPLETE_THRESHOLD=80
