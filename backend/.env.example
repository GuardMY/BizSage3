# BizSage3 Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///bizsage.db
CHECKPOINT_DB_URL=sqlite+aiosqlite:///checkpoints.db

# LLM
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Industry knowledge base. Embeddings reuse OPENAI_* unless explicitly overridden.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-minio-secret-key
MINIO_SECURE=false
MINIO_BUCKET=bizsage-knowledge
KNOWLEDGE_UPLOAD_MAX_BYTES=20971520

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Access control (required). Use a long random value and keep it server-side.
ADMIN_TOKEN=replace-with-a-random-admin-token
AUTH_SESSION_HOURS=12
# Set true when the frontend is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Diagnosis threshold (per design doc: >= 80 triggers diagnosis)
COMPLETE_THRESHOLD=80
